{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "kb",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "chore(release): release${component} ${version}",
      "pull-request-header": ":robot: Release PR do release-please tạo. Trước khi merge: thêm `changelog/vi/<version>.md` (xem `docs/runbooks/release.md`) — check `release-vi-notes` sẽ chèn nó vào CHANGELOG.md.",
      "extra-files": [
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/collab/package.json", "jsonpath": "$.version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Changed" },
        { "type": "refactor", "section": "Changed", "hidden": true },
        { "type": "revert", "section": "Removed" },
        { "type": "security", "section": "Security" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true }
      ]
    }
  }
}
