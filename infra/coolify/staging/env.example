# Environment variables of the Coolify resource "kb-staging" (infra/coolify/staging/docker-compose.yml).
# Set them in Coolify › kb-staging › Environment Variables. NEVER commit real values.
# Secrets: tick "Is Literal?" (no $ interpolation) and lock them. Step by step: docs/runbooks/staging.md.
#
# Supabase values come from the Coolify service "Supabase" (kb-staging project) › Environment
# Variables; the names in brackets are those of the Coolify template (they may differ between
# Coolify versions — check the service's variable list).

# --- set by .github/workflows/deploy.yml on every deploy (create it once by hand, e.g. `main`)
KB_IMAGE_TAG=main

# --- database (internal network only; host = Supabase DB container, see `docker ps | grep supabase-db`)
# postgres role, used only by the one-shot kb-migrate container. [SERVICE_PASSWORD_POSTGRES]
MIGRATE_DATABASE_URL=postgresql://postgres:REPLACE_ME@supabase-db-REPLACE_UUID:5432/postgres
# kb_collab role; password chosen by you (openssl rand -hex 24) and applied with
# `alter role kb_collab password '…'` (runbook step "Mật khẩu role kb_collab").
COLLAB_DATABASE_URL=postgresql://kb_collab:REPLACE_ME@supabase-db-REPLACE_UUID:5432/postgres

# --- Supabase keys
# [SERVICE_PASSWORD_JWT] — kb-collab verifies access tokens with it.
SUPABASE_JWT_SECRET=REPLACE_ME
# [SERVICE_SUPABASEANON_KEY]
SUPABASE_ANON_KEY=REPLACE_ME
# [SERVICE_SUPABASESERVICE_KEY] — server only.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# --- kb-web ↔ kb-collab internal API (T3.7)
# ONE value shared by kb-web and kb-collab (both read this variable), ≥ 32 characters:
#   openssl rand -hex 32
# Requests are signed with a ±60 s window: the host clock must be NTP-synced (timedatectl).
COLLAB_INTERNAL_SECRET=REPLACE_ME

# --- hostnames and TLS (defaults in the compose file keep the Cloudflare Origin CA setup)
# Own domain without Cloudflare proxy (DNS only): let Traefik issue Let's Encrypt certificates.
# KB_WEB_HOST=kb.thanhgo.com
# KB_COLLAB_HOST=kb-collab.thanhgo.com
# KB_TLS_RESOLVER=letsencrypt
# Keep these consistent with the hosts above (and with GoTrue SITE_URL / API_EXTERNAL_URL):
# APP_URL=https://kb.thanhgo.com
# COLLAB_PUBLIC_URL=wss://kb-collab.thanhgo.com
# COLLAB_ALLOWED_ORIGINS=https://kb.thanhgo.com
# MIGRATE_DATABASE_URL needs "?sslmode=disable" when the Supabase Postgres does not serve TLS.

# --- optional (defaults in the compose file)
# APP_URL=https://kb-staging.thanhgo.com
# SUPABASE_URL=https://kb-staging-api.thanhgo.com
# COLLAB_PUBLIC_URL=wss://kb-staging-collab.thanhgo.com
# COLLAB_ALLOWED_ORIGINS=https://kb-staging.thanhgo.com,https://kb-pr-*.thanhgo.com
# COLLAB_LOG_LEVEL=info
# Gmail App Password (docs/PLAN.md §7.14) — may stay empty on staging until invitations (T1.5a).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# ssl | starttls | none; empty = derived from SMTP_PORT (587 → starttls, 465 → ssl).
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_REPLY_TO=
# BOOTSTRAP_SUPER_ADMIN_EMAILS=nguyenthanh.cv@gmail.com
# SENTRY_DSN=
# REDIS_URL=
