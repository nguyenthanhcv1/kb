# Environment of kb-backup (infra/backup/kb-backup.sh). NEVER commit real values.
# Step by step: docs/runbooks/backup-restore.md. Secrets: password manager "kb backup" +
# Coolify (locked) / GitHub Environment `backup`.

# ---------------------------------------------------------------------------------------------
# 1. Coolify resource "kb-backup" on the production server (infra/backup/docker-compose.yml)
# ---------------------------------------------------------------------------------------------
# Image tag in GHCR: `main` (latest main) or a release, e.g. 0.1.0.
KB_BACKUP_IMAGE_TAG=main
# postgres role of the Supabase DB, internal network only. [SERVICE_PASSWORD_POSTGRES]
# Compose maps it to DATABASE_URL inside the container.
BACKUP_DATABASE_URL=postgresql://postgres:REPLACE_ME@supabase-db-REPLACE_UUID:5432/postgres
# Folder in the bucket: prod | staging (lifecycle/lock rules are per prefix).
BACKUP_PREFIX=prod
# Cron in Asia/Ho_Chi_Minh (the image's TZ). Default 02:00 every night.
BACKUP_SCHEDULE=0 2 * * *
# age PUBLIC key(s) (`age1…`); several = comma-separated (e.g. main key + second admin's key).
BACKUP_AGE_RECIPIENT=age1REPLACE_ME
# Cloudflare R2 (S3 API). Endpoint: R2 › Overview › "S3 API", without the bucket name.
S3_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=kb-backups
# R2 API token "kb-backup-writer": Object Read & Write, this bucket only.
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
# Optional: GET after every successful backup (Uptime Kuma push monitor, heartbeat 26 h) and
# after a failed one (e.g. the same Kuma URL with status=down, or healthchecks.io …/fail).
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_FAIL_URL=
# Docker HEALTHCHECK / `kb-backup check` limit.
BACKUP_MAX_AGE_HOURS=26

# Optional / advanced (not in the compose file; add when needed)
# S3_REGION=auto
# S3_PROVIDER=Cloudflare            # rclone provider (fallback: Backblaze B2, AWS…)
# BACKUP_STORAGE_DIR=               # Supabase Storage volume mounted read-only (T3.6): copied to <prefix>/storage/
# BACKUP_WORK_DIR=/tmp              # where the encrypted file is written before upload
# BACKUP_REMOTE=                    # any rclone path instead of R2 (tests: a local directory)

# ---------------------------------------------------------------------------------------------
# 2. Restore / restore test (one-shot `docker run`, GitHub Environment `backup`)
# ---------------------------------------------------------------------------------------------
# Superuser of the TARGET cluster, maintenance database `postgres`. On Supabase: supabase_admin,
# same password as postgres. Restore always creates a NEW database (RESTORE_DB_NAME).
# RESTORE_ADMIN_URL=postgresql://supabase_admin:REPLACE_ME@REPLACE_HOST:5432/postgres
# RESTORE_DB_NAME=kb_restore
# age PRIVATE key: the content (AGE-SECRET-KEY-1…) or a mounted file. Never on the prod server.
# BACKUP_AGE_IDENTITY=
# BACKUP_AGE_IDENTITY_FILE=
# For restore, S3_ACCESS_KEY/S3_SECRET_KEY can be a read-only token ("kb-backup-reader").
# restore-test:
# RESTORE_TEST_DB_NAME=kb_restore_test
# RESTORE_TEST_MIN_PAGES=0
# RESTORE_TEST_HEARTBEAT_URL=
# RESTORE_TEST_HEARTBEAT_FAIL_URL=
# RESTORE_TEST_SCHEDULE=            # only when restore-test runs inside a scheduled container
# RESTORE_TOC_EXCLUDE=              # extra pg_restore --list lines to skip (extended regex)
