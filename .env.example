# Environment variables of kb-web and kb-collab (docs/PLAN.md §7.6). Copy to `.env` for local
# development; on staging/production they are set in Coolify. Validated at startup
# (apps/web/src/lib/env.ts, apps/collab/src/env.ts): a missing required variable stops the
# process with its name. Values below are placeholders.

# --- shared --------------------------------------------------------------------------------
# local | test | preview | staging | production
APP_ENV=local
# Injected by the Docker build (--build-arg); leave unset locally.
# APP_VERSION=0.0.0-dev
# GIT_SHA=unknown
SENTRY_DSN=

# --- kb-web --------------------------------------------------------------------------------
# Required when APP_ENV is preview/staging/production.
APP_URL=http://localhost:3000
# From `supabase status` locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only secret.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
COLLAB_PUBLIC_URL=ws://127.0.0.1:3001
COLLAB_INTERNAL_URL=http://127.0.0.1:3001
# Shared with kb-collab, ≥ 32 characters (openssl rand -hex 32).
COLLAB_INTERNAL_SECRET=
DEFAULT_LOCALE=vi
DEFAULT_TIME_ZONE=Asia/Ho_Chi_Minh
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
# Comma-separated; only used while the DB has no super admin.
BOOTSTRAP_SUPER_ADMIN_EMAILS=

# --- kb-collab -----------------------------------------------------------------------------
PORT=3001
# The next three are required when APP_ENV is preview/staging/production.
# Postgres role kb_collab on the internal network.
DATABASE_URL=
SUPABASE_JWT_SECRET=
# COLLAB_INTERNAL_SECRET (above) is shared.
# Empty = Redis extension off.
REDIS_URL=

# --- kb-migrate (infra/migrate) ------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:<password>@supabase-db:5432/postgres
