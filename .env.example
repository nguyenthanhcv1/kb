# Environment variables of kb-web and kb-collab (docs/PLAN.md §7.6). Copy to `.env` for local
# development (`pnpm dev` loads it into both apps); on staging/production they are set in
# Coolify (list and sources: infra/coolify/staging/env.example, runbook
# docs/runbooks/staging.md). Validated at startup (apps/web/src/lib/env.ts,
# apps/collab/src/env.ts): a missing required variable stops the process with its name.
# Values below are placeholders.

# --- shared --------------------------------------------------------------------------------
# local | test | preview | staging | production
APP_ENV=local
# Injected by the Docker build (--build-arg); leave unset locally.
# APP_VERSION=0.0.0-dev
# GIT_SHA=unknown
SENTRY_DSN=

# --- kb-web --------------------------------------------------------------------------------
# Required when APP_ENV is preview/staging/production.
APP_URL=http://localhost:3000
# From `supabase status` locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
# Browser copies of the two values above (inlined into the client bundle by Next.js).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only secret.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Server-only: HS256 JWT secret of Supabase (`supabase status` → JWT_SECRET). kb-web signs
# short-lived user tokens with it so AI assistants connected over MCP (/api/mcp) act under RLS.
# Empty = the MCP connector is off (503). kb-collab reads the same variable (below).
SUPABASE_JWT_SECRET=
COLLAB_PUBLIC_URL=ws://127.0.0.1:3001
COLLAB_INTERNAL_URL=http://127.0.0.1:3001
# HMAC key of the kb-collab internal API (T3.7). kb-web and kb-collab MUST use the SAME value,
# ≥ 32 characters: `openssl rand -hex 32`. Signatures are valid ±60 s, so the clocks of the two
# processes must agree within 60 s (same host in Coolify; keep NTP on: `timedatectl`).
COLLAB_INTERNAL_SECRET=
DEFAULT_LOCALE=vi
DEFAULT_TIME_ZONE=Asia/Ho_Chi_Minh
# Invitation emails (T1.5a). Unset SMTP_HOST/SMTP_FROM = no email (the admin gets the link to copy).
# Port 465 = TLS, 587 = STARTTLS, other = plain. Local Mailpit (`supabase start`): SMTP_HOST=127.0.0.1
# SMTP_PORT=54325 SMTP_FROM="KB <kb@localhost>", inbox at http://127.0.0.1:54324.
# Production (docs/PLAN.md §7.14): smtp.gmail.com:587 + Workspace App Password.
SMTP_HOST=
SMTP_PORT=587
# ssl (implicit TLS, 465) | starttls (587) | none (local Mailpit: SMTP_HOST=127.0.0.1, SMTP_PORT=54325).
# Empty = derived from SMTP_PORT.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
# Comma-separated; only used while the DB has no super admin.
BOOTSTRAP_SUPER_ADMIN_EMAILS=

# --- kb-collab -----------------------------------------------------------------------------
PORT=3001
LOG_LEVEL=info
# Required when APP_ENV is preview/staging/production (with COLLAB_INTERNAL_SECRET above — the
# same value as kb-web's).
# Postgres role kb_collab on the internal network. Local: see supabase/seed.sql.
DATABASE_URL=postgresql://kb_collab:kb_collab_local@127.0.0.1:54322/postgres
# Comma-separated, `*` wildcard in the host: https://kb.thanhgo.com,https://kb-pr-*.thanhgo.com
ALLOWED_ORIGINS=
# One of SUPABASE_JWT_SECRET (above) / SUPABASE_JWKS_URL is required when DATABASE_URL is set.
SUPABASE_JWKS_URL=
# Empty = Redis extension off.
REDIS_URL=

# --- kb-migrate (infra/migrate) ------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:<password>@supabase-db:5432/postgres
